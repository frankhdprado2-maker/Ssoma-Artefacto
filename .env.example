# Rutas relativas a esta carpeta; no guardar secretos reales en la distribucion.
SSOMA_DATA_DIR=./data
SSOMA_MODEL_DIR=./models
SSOMA_UPLOAD_DIR=./data/uploads
SSOMA_RESULT_DIR=./data/results
SSOMA_DEVICE=auto
SSOMA_BIND=127.0.0.1
PORT=8000
SSOMA_MAX_UPLOAD_MB=1
SSOMA_MAX_VIDEO_SECONDS=2
SSOMA_MAX_ACTIVE_ANALYSES=1
SSOMA_MAX_QUEUED_ANALYSES=2
SSOMA_MAX_ANALYSES=10
SSOMA_RETENTION_HOURS=24
SSOMA_ACCESS_TOKEN=
