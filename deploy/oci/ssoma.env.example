# Install externally at /etc/ssoma/ssoma.env, owner root:ssoma mode 0640.
SSOMA_APP_DIR=/opt/ssoma/app
SSOMA_VENV_DIR=/opt/ssoma/venv
SSOMA_DATA_DIR=/var/lib/ssoma
SSOMA_MODEL_DIR=/opt/ssoma/models
SSOMA_UPLOAD_DIR=/var/lib/ssoma/uploads
SSOMA_RESULT_DIR=/var/lib/ssoma/results
SSOMA_LOG_DIR=/var/log/ssoma
SSOMA_BIND=127.0.0.1
PORT=8000
SSOMA_DEVICE=cpu
SSOMA_MAX_UPLOAD_MB=1
SSOMA_MAX_VIDEO_SECONDS=2
SSOMA_MAX_ACTIVE_ANALYSES=1
SSOMA_MAX_QUEUED_ANALYSES=2
SSOMA_MAX_ANALYSES=10
SSOMA_RETENTION_HOURS=24
# Empty intentionally. Set a strong value externally; startup refuses empty.
SSOMA_ACCESS_TOKEN=
IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
YOLO_AUTOINSTALL=false
ULTRALYTICS_AUTOINSTALL=false
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
