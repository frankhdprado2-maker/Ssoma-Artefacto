[Unit]
Description=SSOMA frozen scientific runtime, OCI operational adapter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=ssoma
Group=ssoma
WorkingDirectory=/opt/ssoma/app
EnvironmentFile=/etc/ssoma/ssoma.env
ExecStart=/bin/bash /opt/ssoma/app/deploy/oci/start_ssoma.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssoma /var/log/ssoma
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
